{
    "Count Prefix": {
        "{N}motion": "repeat motion N times (e.g., 5j)",
        "{N}G": "go to line N",
        "{N}dd": "delete N lines (fold-aware)",
        "{N}yy": "yank N lines (fold-aware)",
        "d{N}d": "delete N lines (e.g., d3d)",
        "{N}x": "delete N chars",
        "{N}p {N}P": "paste N times",
        "{N}J": "join N times"
    },
    "Movement": {
        "h j k l": "left/down/up/right",
        "w b": "word forward/backward",
        "0 $ ^": "line start/end/first char",
        "gg G": "file start/end",
        "%": "jump to matching bracket",
        "PgUp PgDn": "page up/down",
        "Ctrl+d/u": "half page down/up",
        "Ctrl+f/b": "page down/up",
        "Ctrl+e/y": "scroll down/up (1 line)",
        "Ctrl+g": "show file info"
    },
    "Search": {
        "/": "search forward",
        "?": "search backward",
        "n": "next match",
        "N": "previous match",
        "Up/Down": "search history",
        "* #": "search word under cursor (forward/backward)",
        "\\c \\C": "case insensitive/sensitive",
        "smartcase": "lowercase only → case insensitive",
        "/$. /$[": "JSONPath search (auto-detect)",
        "\\j": "JSONPath suffix for other patterns"
    },
    "Insert Mode": {
        "i I": "insert at cursor/line start",
        "a A": "append after cursor/line end",
        "o O": "open line below/above",
        "Tab": "indent (4 spaces)"
    },
    "Editing": {
        "x": "delete char",
        "dd": "delete line",
        "d0": "delete to line start",
        "dw d$": "delete word/to end",
        "cw cc": "change word/line",
        "r{c}": "replace char",
        "J": "join lines",
        "yy p P": "yank/paste after/before",
        "u": "undo",
        "Ctrl+r": "redo",
        ".": "repeat last edit",
        "ej": "edit embedded JSON string",
        "es": "edit multiline string"
    },
    "Visual Mode": {
        "v": "character-wise selection",
        "V": "line-wise selection",
        "d": "delete selection",
        "y": "yank selection",
        "c": "change selection",
        "Esc": "exit visual mode"
    },
    "Folding": {
        "za": "toggle fold",
        "zo": "open fold",
        "zc": "close fold",
        "zM": "fold all",
        "zR": "unfold all"
    },
    "Commands": {
        ":w": "save",
        ":w!": "force save (skip validation)",
        ":w {file}": "save as",
        ":e {file}": "open file",
        ":<num>": "jump to line/record",
        ":$": "jump to last line",
        ":fmt": "format JSON",
        ":s/old/new/": "substitute first match (current line)",
        ":s/old/new/g": "substitute all matches (current line)",
        ":%s/old/new/g": "substitute all (entire file)",
        ":N,Ms/old/new/g": "substitute in line range N to M",
        ":s/$.key/newkey/g": "rename JSON key via JSONPath",
        ":s/$.key=/value/g": "replace JSON value via JSONPath",
        ":n": "next file",
        ":N": "previous file",
        ":e#": "alternate (previous) file",
        ":q": "quit (confirm if changed)",
        ":q!": "quit (discard changes)",
        ":wq": "save and quit",
        ":wq!": "force save and quit",
        ":x": "save and quit (alias for :wq)",
        ":help": "toggle this help",
        "Tab": "path completion for :e, :w"
    },
    "Diff Commands": {
        "]c": "next hunk",
        "[c": "previous hunk",
        ":ig <path>": "ignore JSONPath in diff highlight",
        ":ig": "show ignored paths",
        ":ig!": "clear all ignored paths",
        ":uig <path>": "unignore JSONPath",
        ":uig + Tab": "tab-complete from ignored list",
        "Tab": "switch left/right panel"
    }
}
